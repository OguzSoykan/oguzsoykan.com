{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static personal site served from Workers static assets (existing Worker "oguzsoykan").
  "name": "oguzsoykan",
  "compatibility_date": "2026-10-09",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "oguzsoykan.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
